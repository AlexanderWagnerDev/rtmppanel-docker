# Copy to .env. Reuse the running backend's API token.
# Generate SECRET_KEY with: openssl rand -hex 32 (keep an existing panel's secret).
LRTMP2_API_TOKEN=
SECRET_KEY=
PANEL_PASSWORD=
PANEL_USERNAME=admin
REQUIRE_LOGIN=True
ALLOW_INSECURE_NO_LOGIN=0
GUNICORN_WORKERS=1
RATELIMIT_STORAGE_URI=memory://
PANEL_LANG=en
TZ=UTC
LRTMP2_DOMAIN=localhost
LRTMP2_APP=live
RTMP_PORT=1935
RTMPPANEL_PORT=8001
SESSION_COOKIE_SECURE=False
LRTMP2_API_URL=http://host.docker.internal:8090
# Browser-reachable backend base URL; replace localhost for remote viewers.
LRTMP2_STATS_URL=http://localhost:8090
